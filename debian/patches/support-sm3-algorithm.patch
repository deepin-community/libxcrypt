diff --git a/lib/alg-sm3-hmac.c b/lib/alg-sm3-hmac.c
new file mode 100644
index 0000000..b437aab
--- /dev/null
+++ b/lib/alg-sm3-hmac.c
@@ -0,0 +1,113 @@
